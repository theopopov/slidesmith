# Slidesmith environment (copy to .env; there are no secrets or API keys).
#
# CHROME_BIN — path to a Chrome / Chromium binary used by engine/render.py for
# headless rasterization. Slidesmith defaults to the macOS location below when
# this is unset. Set it explicitly on Linux/Windows or for Chromium.
#
# macOS (default if unset):
#   CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux (examples):
#   CHROME_BIN=/usr/bin/google-chrome
#   CHROME_BIN=/usr/bin/chromium
# Windows (example):
#   CHROME_BIN=C:\Program Files\Google\Chrome\Application\chrome.exe

CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
