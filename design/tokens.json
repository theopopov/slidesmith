      ["color.signal.600", "color", "#0E9E6E"],
      ["color.signal.700", "color", "#0B7D57"],
      ["color.build.500", "color", "#2F6FEB"],
      ["color.build.600", "color", "#1E56C7"],
      ["color.amber.400", "color", "#F5A524"],
      ["color.line.200", "color", "#DCE0D8"],
      ["color.green.500", "color", "#12B981"],
      ["color.red.500", "color", "#E5484D"],
      ["color.white", "color", "#FFFFFF"],
      ["spacing.4", "spacing", "4"],
