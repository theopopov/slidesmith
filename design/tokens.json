    "shadow.card": [{"offsetX": "0", "offsetY": "6", "blur": "20", "spread": "0", "color": "#0F14191A", "inset": false}],
    "shadow.hero-glow": [{"offsetX": "0", "offsetY": "0", "blur": "120", "spread": "12", "color": "#12B98159", "inset": false}]
